# Frontend Environment Configuration Template
# Copy to .env for local development or .env.production for production builds

# API & WebSocket Endpoints
REACT_APP_API_URL=https://api.yourdomain.com/api/
REACT_APP_ASSET_URL=https://api.yourdomain.com/
REACT_APP_WS_URL=wss://api.yourdomain.com/ws

# Optional Meta WhatsApp Embedded Signup Settings
REACT_APP_META_APP_ID=
REACT_APP_META_CONFIG_ID=
REACT_APP_META_GRAPH_VERSION=v22.0

# Development Helpers
REACT_APP_ENABLE_FAKE_DB=false
