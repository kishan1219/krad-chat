# Copy to .env. Never put these values in the React app.
NODE_ENV=development
PORT=your_backend_port
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=https://api.yourdomain.com
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-64-hex-characters
PROVIDER_MODE=mock_or_live
ALLOW_SIGNUP=false
WORKER_ENABLED=true
MOCK_DELIVERY=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
SMS_UNIT_PRICE_PAISE=25
WHATSAPP_UNIT_PRICE_PAISE=100
VOICE_UNIT_PRICE_PAISE=200
# MSG91 flow requires an approved flow/template. DLT fields are supplied per campaign.
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
# Exact approved flow text, using {{variable_name}} placeholders, for segment accounting.
MSG91_TEMPLATE_TEXT=
# Meta: set an explicitly supported Graph API version from your account docs.
META_GRAPH_VERSION=v22.0
META_APP_ID=
META_CONFIG_ID=
# Business tokens and WABA/phone IDs are configured per business in Business Connections.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
# Exotel: api.exotel.com or api.in.exotel.com, account SID and calling flow URL.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_HOST=api.in.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_FLOW_URL=
# Secrets used by non-Meta callbacks. Configure the same secret with the provider.
SMS_WEBHOOK_SECRET=
VOICE_WEBHOOK_SECRET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=
# S3-compatible storage, including R2. Blank endpoint uses AWS S3.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=